{
  "name": "bookrefinery",
  "private": true,
  "version": "0.9.3",
  "description": "Local-first EPUB, FB2, and PDF repair, sanitization, OCR, and multimodal LLM preparation.",
  "author": {
    "name": "leshxt",
    "email": "208818173+leshxt@users.noreply.github.com"
  },
  "homepage": "https://github.com/leshxt/BookRefinery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leshxt/BookRefinery.git"
  },
  "bugs": {
    "url": "https://github.com/leshxt/BookRefinery/issues"
  },
  "type": "module",
  "main": "desktop/main.mjs",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/sync-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-ocr-assets.mjs",
    "build": "tsc -b && vite build && node scripts/build-service-worker.mjs",
    "build:desktop": "node scripts/sync-ocr-assets.mjs && tsc -b && vite build --mode desktop && node scripts/build-service-worker.mjs",
    "desktop:dev": "npm run build:desktop && electron .",
    "desktop:build": "npm run build:desktop && electron-builder --publish never",
    "desktop:build:windows": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "desktop:build:linux": "npm run build:desktop && electron-builder --linux AppImage deb --x64 --publish never",
    "desktop:unpacked:windows": "npm run build:desktop && electron-builder --win dir --x64 --publish never",
    "desktop:check": "node --check desktop/main.mjs && node --check desktop/preload.cjs && node --check desktop/after-pack.mjs && node --test desktop/*.test.mjs",
    "desktop:audit": "npm audit --include=dev --audit-level=high",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run test && npm run build && npm run audit",
    "verify:desktop": "npm run verify && npm run desktop:check && npm run desktop:audit"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "node-html-markdown": "2.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.6",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "io.github.leshxt.bookrefinery",
    "productName": "BookRefinery",
    "asar": true,
    "npmRebuild": false,
    "afterPack": "desktop/after-pack.mjs",
    "directories": {
      "output": "release-artifacts"
    },
    "files": [
      "dist/**/*",
      "desktop/main.mjs",
      "desktop/preload.cjs",
      "desktop/security-policy.mjs",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES/**/*"
    ],
    "artifactName": "BookRefinery-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "desktop/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "icon": "desktop/icons/128x128@2x.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
