{
  "name": "bookrefinery",
  "private": true,
  "version": "0.4.0",
  "description": "Local-first EPUB, FB2, and PDF sanitizer for searchable, multimodal LLM source packages.",
  "homepage": "https://github.com/leshxt/BookRefinery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leshxt/BookRefinery.git"
  },
  "bugs": {
    "url": "https://github.com/leshxt/BookRefinery/issues"
  },
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/sync-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-ocr-assets.mjs",
    "build": "tsc -b && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run test && npm run build && npm run audit"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fast-xml-parser": "5.10.0",
    "fflate": "0.8.3",
    "node-html-markdown": "2.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
