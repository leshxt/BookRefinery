{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookRefinery",
  "version": "0.5.0",
  "identifier": "io.github.leshxt.bookrefinery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "BookRefinery",
        "width": 1240,
        "height": 900,
        "minWidth": 820,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#07100e",
        "additionalBrowserArgs": "--disable-background-networking --disable-component-update --disable-crash-reporter --disable-dns-prefetch --disable-domain-reliability --disable-sync --host-resolver-rules=\"MAP * ~NOTFOUND\" --metrics-recording-only --no-first-run --no-pings --proxy-server=http://127.0.0.1:9 --proxy-bypass-list=<-loopback>"
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Prepare untrusted ebooks locally for LLMs and safe archives.",
    "longDescription": "Inspect, sanitize, OCR, and reshape EPUB, FB2, and PDF ebooks into trustworthy multimodal sources without uploading them.",
    "publisher": "leshxt",
    "copyright": "Copyright © 2026 leshxt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ]
      }
    }
  }
}
